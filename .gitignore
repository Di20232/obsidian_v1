# Estado da janela do Obsidian: muda a cada clique, não é conhecimento
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# Exportação para IA: gerada a partir das notas, recriável a qualquer momento
exportacao/

# Saídas dos experimentos de GAN (modelos treinados, desenhos, histórico): recriáveis rodando os scripts
GANs/exemplos/saida/
__pycache__/

# Saídas dos exemplos das trilhas: recriadas ao rodar os scripts
SQLite/exemplos/tarefas.db
PHP/exemplos/banco.db
/tarefas.txt
Python/exemplos/tarefas.txt

# Lixeira interna do Obsidian
.trash/

# Script de trabalho com dados de servidor interno: fica só no computador
ativar_9227.bat

# Arquivos de sistema
.DS_Store
Thumbs.db
desktop.ini
